{
  "name": "view-prs",
  "version": "1.0.0",
  "description": "View the status of PRs",
  "main": "src/server/server.js",
  "scripts": {
    "deps:check": "node src/dependencies/check-deps.js",
    "report:auto-refresh": "node src/dependencies/report-auto-refresh-metrics.js",
    "guard:state-writes": "node src/dependencies/check-protected-state-writes.js",
    "guard:state-health": "node src/dependencies/check-state-health.js",
    "validate:schema": "node src/schema/validate-data-schema.js",
    "migrate:pr-detail:v1": "node src/script/migrate-pr-detail-sidecar-v1.js",
    "backfill:missing": "node src/backfill/backfill-missing-data.js",
    "backfill:missing:dry": "node src/backfill/backfill-missing-data.js --dry-run",
    "backfill:missing:bg": "sh src/backfill/backfill-missing-bg.sh start",
    "backfill:missing:bg:stop": "sh src/backfill/backfill-missing-bg.sh stop",
    "backfill:missing:bg:status": "sh src/backfill/backfill-missing-bg.sh status",
    "cli-view": "npm run deps:check && sh src/script/check-open-pr-updates.sh --open none",
    "start": "node src/server/server.js",
    "test": "jest",
    "test:ui": "jest src/ui/**/*.test.js",
    "test:ui:dom": "jest --env=jsdom",
    "test:script": "jest src/script/tests/*.test.js",
    "test:schema": "jest src/schema/tests/*.test.js",
    "test:deps": "jest src/dependencies/tests/*.test.js",
    "test:backfill": "jest src/backfill/tests/*.test.js",
    "test:all": "npm run guard:state-writes && npm run guard:state-health && npm test -- --runInBand --detectOpenHandles && npm run guard:state-health",
    "test:coverage": "npm run guard:state-writes && npm run guard:state-health && npm test -- --runInBand --detectOpenHandles --coverage && npm run guard:state-health",
    "test:ci": "npm run test:coverage",
    "check:all": "npm run deps:check && npm run lint:check && npm run validate:schema && npm run test:coverage",
    "test:app": "jest src/server/tests/*.test.js",
    "lint:check": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "author": "Alison Hall",
  "license": "ISC",
  "dependencies": {
    "marked": "^17.0.5"
  },
  "devDependencies": {
    "@eslint/css": "^1.1.0",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^1.2.0",
    "@eslint/markdown": "^8.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.1",
    "ajv": "^8.18.0",
    "eslint": "^10.2.1",
    "globals": "^17.5.0",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.4.1",
    "supertest": "^6.3.4"
  }
}
